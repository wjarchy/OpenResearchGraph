# OpenResearchGraph runs in deterministic demo mode when these values are empty.
ORG_LLM_BASE_URL=
ORG_LLM_API_KEY=
ORG_LLM_MODEL=

# Optional GET search adapter. Contract: ?q=...&limit=... -> {"results": [...]}
ORG_WEB_SEARCH_BASE_URL=
ORG_WEB_SEARCH_API_KEY=

# Local knowledge files (.md/.txt/.json/.csv) stay on this machine.
ORG_KNOWLEDGE_DIR=./data/knowledge

# Optional production-like two-layer memory. Install with: pip install -e ".[memory]"
ORG_MEMORY_BACKEND=local
ORG_POSTGRES_DSN=
ORG_MILVUS_URI=
ORG_MILVUS_TOKEN=
ORG_MILVUS_COLLECTION=openresearchgraph_memory

# Local, non-secret defaults
ORG_DATABASE_URL=sqlite:///./data/openresearchgraph.db
ORG_ALLOWED_ORIGINS=http://localhost:8000
ORG_MAX_SEARCH_ROUNDS=3
ORG_MAX_SQL_ROWS=500
ORG_SQL_TIMEOUT_SECONDS=2
ORG_PYTHON_TIMEOUT_SECONDS=2
ORG_LOG_LEVEL=INFO
