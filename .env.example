# OpenResearchGraph runs in deterministic demo mode when these values are empty.
ORG_LLM_BASE_URL=
ORG_LLM_API_KEY=
ORG_LLM_MODEL=

# Local, non-secret defaults
ORG_DATABASE_URL=sqlite:///./data/openresearchgraph.db
ORG_ALLOWED_ORIGINS=http://localhost:8000
ORG_MAX_SEARCH_ROUNDS=3
ORG_MAX_SQL_ROWS=500
ORG_SQL_TIMEOUT_SECONDS=2
ORG_LOG_LEVEL=INFO
